{
  "name": "@local/dsh-galtransl-preset",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GalTransl Agent 预设（dsh bundle）：挂载 GalTransl MCP 工具 + 子代理（子代理继承同一 MCP 工具面），不含文件/Shell/网页工具。",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "galtransl.preset.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
